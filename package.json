{
  "name": "my-app",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch src/index.tsx\" \"tailwindcss -i src/styles/input.css -o public/output.css --watch\"",
    "build:css": "tailwindcss -i src/styles/input.css -o public/output.css --minify",
    "build": "npm run build:css && tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@hono/node-server": "^2.1.1",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "daisyui": "^5.7.22",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "lucide-static": "^1.35.0",
    "postgres": "^3.4.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
